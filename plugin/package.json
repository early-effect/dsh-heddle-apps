{
  "name": "@early-effect/dsh-heddle-apps",
  "version": "0.0.0",
  "private": true,
  "description": "MCP Apps host row and web frame for DeepSeek Harness",
  "type": "module",
  "main": "./entry.js",
  "exports": {
    ".": "./entry.js",
    "./client": "./client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "entry.js",
    "config.js",
    "client.js",
    "cordis.patch.yml",
    "package.json"
  ],
  "dependencies": {
    "@deepseek-ai/schemastery": "3.18.4"
  },
  "peerDependencies": {
    "react": "^18",
    "@deepseek-ai/cordis": "~4.0.4",
    "@deepseek-ai/dsh-typert-protocol": "0.2.0-rc.2"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-ui-tool",
        "@deepseek-ai/dsh-api-remotes",
        "@deepseek-ai/dsh-client-connection"
      ],
      "platform": "web"
    }
  }
}
